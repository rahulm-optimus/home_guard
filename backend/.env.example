# Application Configuration
APP_NAME=Home Guard API
APP_VERSION=1.0.0
DEBUG=False

# SQL Server Configuration
# Set these values to connect to your SQL Server database
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=PlsBody
SQL_USERNAME=your-username
SQL_PASSWORD=your-password
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_CONNECTION_TIMEOUT=30
SQL_ENCRYPT=True
SQL_TRUST_SERVER_CERTIFICATE=True

# Azure Cosmos DB Configuration (Legacy - Optional)
# COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_DB_KEY=your-key
# COSMOS_DB_DATABASE_NAME=homeguard
# COSMOS_DB_CONTAINER_NAME=estimates
# COSMOS_DB_CLUSTER_CONTAINER_NAME=zipcodeClusters

# Azure AI Foundry Agent Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_AI_PROJECT_ENDPOINT=https://aif-home-inspection-ai-dev-wu-01.services.ai.azure.com/api/projects/proj-home-inspection-ai-dev-wu-01
AZURE_CHAT_AGENT_ID=asst_BFZt4Wu3VmOom3rzXuufpg8I
AZURE_AI_COSMOS_AGENT_ID=asst_s2yLseFSPnlz0ZaklQjWeRXV
AZURE_AGENT_ID=asst_yu3JjVuwV5Zag4eOxiiXfizt
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Agent Feature Flags
AZURE_AGENT_USE_BING=True
AZURE_AGENT_CHECK_DB_FIRST=True

# Server Configuration
PORT=5000

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
